  obligation                      RegulatoryObligation? @relation("ComplianceClock_obligation", fields: [obligationId], references: [id])
  obligationId                    String?               @map("obligation")
  obligationCode                  String                @default("")
  community                       Community?            @relation("ComplianceClock_community", fields: [communityId], references: [id])
  communityId                     String?               @map("community")
  resident                        Resident?             @relation("ComplianceClock_resident", fields: [residentId], references: [id])
  residentId                      String?               @map("resident")
  subjectType                     String                @default("")
  subjectId                       String                @default("")
  occurrenceKey                   String                @default("")
  startedAt                       DateTime?
  dueAt                           DateTime?
  status                          String                @default("open")
  ownerRole                       String                @default("")
  escalationLevel                 Int?                  @default(0)
  satisfiedBy                     Json?
  satisfiedAt                     DateTime?
  cancelReason                    String                @default("")
  supersedes                      ComplianceClock?      @relation("ComplianceClock_supersedes", fields: [supersedesId], references: [id])
  supersedesId                    String?               @map("supersedes")
  current                         Boolean               @default(true)
  ruleRef                         String                @default("")
  verifyNote                      String                @default("")
  version                         Int                   @default(0)
  createdAt                       DateTime              @default(now())
  updatedAt                       DateTime              @default(now()) @updatedAt
  from_ComplianceClock_supersedes ComplianceClock[]     @relation("ComplianceClock_supersedes")

  @@unique([obligationCode, subjectType, subjectId, occurrenceKey, supersedesId], map: "ComplianceClock_occurrence_key")
  @@index([obligationId])
  @@index([obligationCode])
  @@index([communityId])
  @@index([residentId])
  @@index([subjectId])
  @@index([supersedesId])
}

