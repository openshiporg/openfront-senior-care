  by        User?     @relation("SalesActivity_by", fields: [byId], references: [id])
  byId      String?   @map("by")
  summary   String    @default("")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt

  @@index([leadId])
  @@index([byId])
}

model StaffBio {
  id                String          @id @default(cuid())
  site              StorefrontSite? @relation("StaffBio_site", fields: [siteId], references: [id])
  siteId            String?         @map("site")
  name              String          @default("")
  title             String          @default("")
  bio               String          @default("")
  photo             Document?       @relation("StaffBio_photo", fields: [photoId], references: [id])
  photoId           String?         @map("photo")
  sortOrder         Int?            @default(0)
  consentDocument   Document?       @relation("StaffBio_consentDocument", fields: [consentDocumentId], references: [id])
  consentDocumentId String?         @map("consentDocument")
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @default(now()) @updatedAt

  @@index([siteId])
  @@index([photoId])
  @@index([consentDocumentId])
}

model StorefrontSite {
  id                 String     @id @default(cuid())
  community          Community? @relation("Community_storefront")
  published          Boolean    @default(false)
  heroTitle          String     @default("")
  heroBody           String     @default("")
  amenities          Json?      @default("[]")
  diningCopy         String     @default("")
  activitiesCopy     String     @default("")
  careLevelsCopy     String     @default("")
  gallery            Document[] @relation("StorefrontSite_gallery")
  staffBios          StaffBio[] @relation("StaffBio_site")
  faq                Json?      @default("[]")
  showCmsRatings     Boolean    @default(false)
  acceptedPayers     Json?      @default("[]")
  seo                Json?      @default("{}")
  tourBookingEnabled Boolean    @default(true)
  waitlistEnabled    Boolean    @default(true)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @default(now()) @updatedAt
}

model Tour {
  id             String     @id @default(cuid())
  publicCode     String     @unique @default("")
  community      Community? @relation("Tour_community", fields: [communityId], references: [id])
  communityId    String?    @map("community")
  slot           TourSlot?  @relation("Tour_slot", fields: [slotId], references: [id])
  slotId         String?    @map("slot")
  lead           Lead?      @relation("Tour_lead", fields: [leadId], references: [id])
  leadId         String?    @map("lead")
  kind           String
  status         String     @default("requested")
  guestTokenHash String     @default("")
  holdExpiresAt  DateTime?
  notes          String     @default("")
  version        Int        @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @default(now()) @updatedAt

  @@index([communityId])
  @@index([slotId])
  @@index([leadId])
}

model TourSlot {
  id          String     @id @default(cuid())
  community   Community? @relation("TourSlot_community", fields: [communityId], references: [id])
  communityId String?    @map("community")
  startsAt    DateTime
  endsAt      DateTime
  capacity    Int        @default(2)
  kind        String     @default("either")
  host        User?      @relation("TourSlot_host", fields: [hostId], references: [id])
  hostId      String?    @map("host")
  tours       Tour[]     @relation("Tour_slot")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @default(now()) @updatedAt

  @@index([communityId])
  @@index([hostId])
}

model WaitlistEntry {
  id                                  String             @id @default(cuid())
  reference                           String             @unique @default("")
  community                           Community?         @relation("WaitlistEntry_community", fields: [communityId], references: [id])
  communityId                         String?            @map("community")
  prospect                            Prospect?          @relation("WaitlistEntry_prospect", fields: [prospectId], references: [id])
  prospectId                          String?            @map("prospect")
  lead                                Lead?              @relation("WaitlistEntry_lead", fields: [leadId], references: [id])
  leadId                              String?            @map("lead")
  apartmentType                       ApartmentType?     @relation("WaitlistEntry_apartmentType", fields: [apartmentTypeId], references: [id])
  apartmentTypeId                     String?            @map("apartmentType")
  setting                             String?
  priority                            Int?               @default(100)
  priorityReason                      String?            @default("date_order")
  status                              String             @default("active")
  offeredReservation                  PlaceReservation?  @relation("WaitlistEntry_offeredReservation", fields: [offeredReservationId], references: [id])
  offeredReservationId                String?            @map("offeredReservation")
  offerExpiresAt                      DateTime?
  version                             Int                @default(0)
  createdAt                           DateTime           @default(now())
  updatedAt                           DateTime           @default(now()) @updatedAt
  from_PlaceReservation_waitlistEntry PlaceReservation[] @relation("PlaceReservation_waitlistEntry")

  @@index([communityId])
  @@index([prospectId])
  @@index([leadId])
  @@index([apartmentTypeId])
  @@index([offeredReservationId])
}

enum UserKindType {
  staff
  portal
  surveyor
  auditor
  administrator
}
