  community      Community? @relation("IncidentInvestigation_community", fields: [communityId], references: [id])
  communityId    String?    @map("community")
  incident       Incident?  @relation("IncidentInvestigation_incident", fields: [incidentId], references: [id])
  incidentId     String?    @map("incident")
  findings       String     @default("")
  rootCause      String     @default("")
  interventions  String     @default("")
  status         String     @default("open")
  investigator   User?      @relation("IncidentInvestigation_investigator", fields: [investigatorId], references: [id])
  investigatorId String?    @map("investigator")
  startedAt      DateTime?
  completedAt    DateTime?
  version        Int        @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @default(now()) @updatedAt

  @@index([residentId])
  @@index([communityId])
  @@index([incidentId])
  @@index([investigatorId])
}

model IncidentParty {
  id          String     @id @default(cuid())
  resident    Resident?  @relation("IncidentParty_resident", fields: [residentId], references: [id])
  residentId  String?    @map("resident")
  community   Community? @relation("IncidentParty_community", fields: [communityId], references: [id])
  communityId String?    @map("community")
  incident    Incident?  @relation("IncidentParty_incident", fields: [incidentId], references: [id])
  incidentId  String?    @map("incident")
  role        String
  name        String     @default("")
  notifiedAt  DateTime?
  version     Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @default(now()) @updatedAt

  @@index([residentId])
  @@index([communityId])
  @@index([incidentId])
}

model InfectionCase {
  id                         String             @id @default(cuid())
  resident                   Resident?          @relation("InfectionCase_resident", fields: [residentId], references: [id])
  residentId                 String?            @map("resident")
  community                  Community?         @relation("InfectionCase_community", fields: [communityId], references: [id])
  communityId                String?            @map("community")
  syndrome                   String
  status                     String             @default("suspected")
  onsetAt                    DateTime?
  criteria                   Json?
  organism                   String             @default("")
  criteriaMet                Boolean            @default(false)
  criteriaSet                String             @default("")
  cultureAt                  DateTime?
  outbreak                   Outbreak?          @relation("InfectionCase_outbreak", fields: [outbreakId], references: [id])
  outbreakId                 String?            @map("outbreak")
  version                    Int                @default(0)
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @default(now()) @updatedAt
  from_AntibioticCourse_case AntibioticCourse[] @relation("AntibioticCourse_case")
  from_PrecautionOrder_case  PrecautionOrder[]  @relation("PrecautionOrder_case")

  @@index([residentId])
  @@index([communityId])
  @@index([outbreakId])
}

model Outbreak {
  id           String          @id @default(cuid())
  community    Community?      @relation("Outbreak_community", fields: [communityId], references: [id])
  communityId  String?         @map("community")
  name         String          @default("")
  organism     String          @default("")
  unit         Unit?           @relation("Outbreak_unit", fields: [unitId], references: [id])
  unitId       String?         @map("unit")
  status       String          @default("declared")
  declaredAt   DateTime?
  declaredBy   User?           @relation("Outbreak_declaredBy", fields: [declaredById], references: [id])
  declaredById String?         @map("declaredBy")
  closedAt     DateTime?
  cases        InfectionCase[] @relation("InfectionCase_outbreak")
  version      Int             @default(0)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @default(now()) @updatedAt

  @@index([communityId])
  @@index([unitId])
  @@index([declaredById])
}

model PrecautionOrder {
  id          String         @id @default(cuid())
  resident    Resident?      @relation("PrecautionOrder_resident", fields: [residentId], references: [id])
  residentId  String?        @map("resident")
  community   Community?     @relation("PrecautionOrder_community", fields: [communityId], references: [id])
  communityId String?        @map("community")
  kind        String
  case        InfectionCase? @relation("PrecautionOrder_case", fields: [caseId], references: [id])
  caseId      String?        @map("case")
  status      String         @default("active")
  startedAt   DateTime?
  endedAt     DateTime?
  reviewOn    DateTime?      @postgresql.Date
  reason      String         @default("")
  version     Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @default(now()) @updatedAt

  @@index([residentId])
  @@index([communityId])
  @@index([caseId])
}

model RegulatoryReport {
  id            String     @id @default(cuid())
  resident      Resident?  @relation("RegulatoryReport_resident", fields: [residentId], references: [id])
  residentId    String?    @map("resident")
  community     Community? @relation("RegulatoryReport_community", fields: [communityId], references: [id])
  communityId   String?    @map("community")
  incident      Incident?  @relation("RegulatoryReport_incident", fields: [incidentId], references: [id])
  incidentId    String?    @map("incident")
  kind          String
  status        String     @default("draft")
  body          Json?
  channel       String?
  confirmation  String     @default("")
  submittedAt   DateTime?
  submittedBy   User?      @relation("RegulatoryReport_submittedBy", fields: [submittedById], references: [id])
  submittedById String?    @map("submittedBy")
  ruleNote      String     @default("")
  version       Int        @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @default(now()) @updatedAt

  @@index([residentId])
  @@index([communityId])
  @@index([incidentId])
  @@index([submittedById])
}

model EvidenceRef {
  id          String     @id @default(cuid())
  community   Community? @relation("EvidenceRef_community", fields: [communityId], references: [id])
  communityId String?    @map("community")
  finding     Finding?   @relation("EvidenceRef_finding", fields: [findingId], references: [id])
  findingId   String?    @map("finding")
  recordType  String     @default("")
  recordId    String     @default("")
  spanStart   Int?
  spanEnd     Int?
  quote       String     @default("")
  version     Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @default(now()) @updatedAt

  @@index([communityId])
  @@index([findingId])
}

model Finding {
  id                String           @id @default(cuid())
  community         Community?       @relation("Finding_community", fields: [communityId], references: [id])
  communityId       String?          @map("community")
  resident          Resident?        @relation("Finding_resident", fields: [residentId], references: [id])
  residentId        String?          @map("resident")
  workflowVersion   WorkflowVersion? @relation("Finding_workflowVersion", fields: [workflowVersionId], references: [id])
  workflowVersionId String?          @map("workflowVersion")
  run               WorkflowRun?     @relation("Finding_run", fields: [runId], references: [id])
  runId             String?          @map("run")
  workflowCode      String           @default("")
  dedupeKey         String           @unique @default("")
  title             String           @default("")
  detail            String           @default("")
  severity          String?          @default("warning")
  status            String           @default("open")
  evidence          EvidenceRef[]    @relation("EvidenceRef_finding")
  task              Task?            @relation("Finding_task", fields: [taskId], references: [id])
  taskId            String?          @map("task")
  proposal          Proposal?        @relation("Finding_proposal", fields: [proposalId], references: [id])
  proposalId        String?          @map("proposal")
  resolvedAt        DateTime?
  resolutionNote    String           @default("")
  dismissedBy       User?            @relation("Finding_dismissedBy", fields: [dismissedById], references: [id])
  dismissedById     String?          @map("dismissedBy")
  version           Int              @default(0)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @default(now()) @updatedAt

  @@index([communityId])
  @@index([residentId])
  @@index([workflowVersionId])
  @@index([runId])
  @@index([workflowCode])
  @@index([taskId])
  @@index([proposalId])
  @@index([dismissedById])
}

model InferenceCall {
  id                                      String            @id @default(cuid())
  community                               Community?        @relation("InferenceCall_community", fields: [communityId], references: [id])
  communityId                             String?           @map("community")
  purpose                                 String
  provider                                String            @default("")
  providerClass                           String
  model                                   String            @default("")
  outcome                                 String
  policyAtCall                            String            @default("")
  inputHash                               String            @default("")
  outputHash                              String            @default("")
  inputTokens                             Int?
  outputTokens                            Int?
  reason                                  String            @default("")
  at                                      DateTime?
  actor                                   User?             @relation("InferenceCall_actor", fields: [actorId], references: [id])
  actorId                                 String?           @map("actor")
  version                                 Int               @default(0)
  createdAt                               DateTime          @default(now())
  updatedAt                               DateTime          @default(now()) @updatedAt
  from_WorkflowVersion_createdByInference WorkflowVersion[] @relation("WorkflowVersion_createdByInference")

  @@index([communityId])
  @@index([actorId])
}

model WorkflowActivation {
  id                String           @id @default(cuid())
  community         Community?       @relation("WorkflowActivation_community", fields: [communityId], references: [id])
  communityId       String?          @map("community")
  workflowVersion   WorkflowVersion? @relation("WorkflowActivation_workflowVersion", fields: [workflowVersionId], references: [id])
  workflowVersionId String?          @map("workflowVersion")
  status            String           @default("active")
  approvals         Json?
  activatedAt       DateTime?
  activatedBy       User?            @relation("WorkflowActivation_activatedBy", fields: [activatedById], references: [id])
  activatedById     String?          @map("activatedBy")
  version           Int              @default(0)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @default(now()) @updatedAt

  @@index([communityId])
  @@index([workflowVersionId])
  @@index([activatedById])
}

model WorkflowDefinition {
  id          String            @id @default(cuid())
  community   Community?        @relation("WorkflowDefinition_community", fields: [communityId], references: [id])
  communityId String?           @map("community")
  code        String            @default("")
  name        String            @default("")
  description String            @default("")
  origin      String
  status      String            @default("active")
  versions    WorkflowVersion[] @relation("WorkflowVersion_definition")
  version     Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @default(now()) @updatedAt

  @@index([communityId])
  @@index([code])
}

model WorkflowRun {
  id                String           @id @default(cuid())
  community         Community?       @relation("WorkflowRun_community", fields: [communityId], references: [id])
  communityId       String?          @map("community")
  workflowVersion   WorkflowVersion? @relation("WorkflowRun_workflowVersion", fields: [workflowVersionId], references: [id])
  workflowVersionId String?          @map("workflowVersion")
  windowKey         String           @unique @default("")
  trigger           String
  status            String           @default("running")
  startedAt         DateTime?
  finishedAt        DateTime?
  findingsOpened    Int?             @default(0)
  findingsResolved  Int?             @default(0)
  summary           Json?
  version           Int              @default(0)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @default(now()) @updatedAt
  from_Finding_run  Finding[]        @relation("Finding_run")

  @@index([communityId])
  @@index([workflowVersionId])
}

model WorkflowVersion {
  id                               String               @id @default(cuid())
  community                        Community?           @relation("WorkflowVersion_community", fields: [communityId], references: [id])
  communityId                      String?              @map("community")
  definition                       WorkflowDefinition?  @relation("WorkflowVersion_definition", fields: [definitionId], references: [id])
  definitionId                     String?              @map("definition")
  versionNumber                    Int?
  graph                            Json?
  graphHash                        String               @default("")
  policyVersion                    String               @default("")
  policy                           Json?
  status                           String               @default("draft")
  dryRun                           Json?
  createdByInference               InferenceCall?       @relation("WorkflowVersion_createdByInference", fields: [createdByInferenceId], references: [id])
  createdByInferenceId             String?              @map("createdByInference")
  description                      String               @default("")
  activations                      WorkflowActivation[] @relation("WorkflowActivation_workflowVersion")
  version                          Int                  @default(0)
  createdAt                        DateTime             @default(now())
  updatedAt                        DateTime             @default(now()) @updatedAt
  from_Finding_workflowVersion     Finding[]            @relation("Finding_workflowVersion")
  from_WorkflowRun_workflowVersion WorkflowRun[]        @relation("WorkflowRun_workflowVersion")

  @@index([communityId])
  @@index([definitionId])
  @@index([createdByInferenceId])
}

