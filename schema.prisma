  metric        String
  value         String     @default("")
  effectiveFrom DateTime?  @postgresql.Date
  effectiveTo   DateTime?  @postgresql.Date
  status        String     @default("active")
  ruleRef       String     @default("")
  note          String     @default("")
  version       Int        @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @default(now()) @updatedAt

  @@index([communityId])
  @@index([unitId])
}

enum UserKindType {
  staff
  portal
  surveyor
  auditor
  administrator
}
